# Neon Postgres URL with SSL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# GitHub OAuth App callback: https://YOUR-API.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste PEM key; literal \n separators are supported
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Signing key: generate a unique random value
FORGE_SESSION_SECRET=
FORGE_FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
FORGE_CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
FORGE_ENV=production

# Select one: groq, openrouter, openai
FORGE_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
FORGE_BASE_URL=
FORGE_MODEL=openai/gpt-oss-20b

FORGE_MAX_ITERATIONS=20
FORGE_COMMAND_TIMEOUT=30
FORGE_WORKSPACE_ROOT=/opt/render/project/src/.forge/workspaces
