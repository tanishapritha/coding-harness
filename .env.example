DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

FORGE_SESSION_SECRET=replace-with-a-long-random-secret
FORGE_FRONTEND_URL=http://localhost:3000

# LLM provider: groq, openrouter, or openai
FORGE_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
FORGE_BASE_URL=
FORGE_MODEL=openai/gpt-oss-20b

FORGE_MAX_ITERATIONS=20
FORGE_COMMAND_TIMEOUT=30
